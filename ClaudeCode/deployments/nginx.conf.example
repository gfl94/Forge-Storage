server {
    listen 443 ssl http2;
    server_name storage.example.com;

    # SSL configuration (adjust paths as needed)
    # ssl_certificate /etc/ssl/certs/storage.example.com.crt;
    # ssl_certificate_key /etc/ssl/private/storage.example.com.key;

    # Static frontend files
    root /var/www/storage-ui;
    index index.html;

    # Security headers
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy no-referrer-when-downgrade always;

    # Serve static frontend files
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Proxy API requests to Go backend
    location /api/ {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
    }

    # Health check endpoint for Nginx
    location = /healthz-nginx {
        return 200 "ok\n";
        add_header Content-Type text/plain;
    }

    # Proxy health endpoint to backend
    location = /health {
        proxy_pass http://127.0.0.1:8081;
    }

    # Proxy readiness endpoint to backend
    location = /ready {
        proxy_pass http://127.0.0.1:8081;
    }
}

# HTTP to HTTPS redirect (optional)
server {
    listen 80;
    server_name storage.example.com;
    return 301 https://$server_name$request_uri;
}
