# Storage API configuration
# Copy this file to /etc/storage-api/storage-api.env and adjust values.

# Application
APP_ENV=production
APP_ADDR=127.0.0.1:8081
APP_BASE_URL=https://storage.example.com

# Session
SESSION_COOKIE_NAME=storage_session
SESSION_COOKIE_SECURE=true
SESSION_TTL_HOURS=168

# Database
SQLITE_PATH=/var/lib/storage-api/storage.db

# Metadata cache TTLs
METADATA_CACHE_DIR_TTL_SECONDS=60
METADATA_CACHE_OBJECT_TTL_SECONDS=120

# Storage provider
STORAGE_PROVIDER=azure
AZURE_STORAGE_ACCOUNT=your_account_name
AZURE_STORAGE_CONTAINER=files
AZURE_STORAGE_KEY=your_account_key

# Signed URL expiry
SIGNED_URL_TTL_SECONDS=300

# Logging
LOG_LEVEL=info

# Default admin password (only used on first run to seed the admin user)
ADMIN_PASSWORD=changeme
